---
import BrowserMock from '~/components/BrowserMock.astro';

export interface ProjectItem {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: readonly string[] | string[];
  highlights: readonly string[] | string[];
  cover: { tagline: string; urlLabel: string };
  url?: string;
  year: string;
  bg: string;
  fg: string;
  monogram: string;
  kind?: 'software' | 'research';
}

export interface Props {
  title?: string;
  kicker?: string;
  items: ProjectItem[];
  countLabel: string;
  openLabel: string;
  visitLabel: string;
  noUrlLabel: string;
  researchBadge?: string;
}

const {
  title = '',
  kicker = '',
  items,
  countLabel,
  openLabel,
  visitLabel,
  noUrlLabel,
  researchBadge = 'Investigación',
}: Props = Astro.props;

const cid = `pc-${(kicker || title || 'grid').replace(/[^\w]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="mt-2" data-reveal>
  <div class="flex items-center justify-end gap-3 mb-5">
    <button
      type="button"
      data-scroll={cid}
      data-dir="-1"
      class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white"
      aria-label="Anterior"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 4L7 10l6 6" />
      </svg>
    </button>
    <button
      type="button"
      data-scroll={cid}
      data-dir="1"
      class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white"
      aria-label="Siguiente"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 4l6 6-6 6" />
      </svg>
    </button>
  </div>

  <div class="relative" data-fade-wrap={cid}>
    <!-- Fade solo cuando hay contenido oculto a la izquierda -->
    <div
      data-fade-left={cid}
      class="pointer-events-none absolute inset-y-0 left-0 w-10 z-10 bg-gradient-to-r from-paper to-transparent opacity-0 transition-opacity duration-300"
      aria-hidden="true"
    ></div>
    <!-- Fade solo cuando hay contenido oculto a la derecha (siguiente proyecto difuminado) -->
    <div
      data-fade-right={cid}
      class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-24 z-10 bg-gradient-to-l from-paper via-paper/70 to-transparent opacity-0 transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <div
      id={cid}
      class="h-scroll overflow-x-auto flex gap-4 sm:gap-5 scroll-smooth pb-4 -mx-4 px-4 cursor-grab active:cursor-grabbing"
    >
      {items.map((p, i) => (
        <article
          data-tilt
          data-kind={p.kind || 'software'}
          class="proj-card snap-start group relative flex-none w-[85%] sm:w-[360px] lg:w-[400px] flex flex-col rounded-2xl overflow-hidden border border-slate-200 bg-white"
        >
          <div class="relative h-36 overflow-hidden">
            <BrowserMock
              bg={p.bg}
              fg={p.fg}
              tagline={p.cover.tagline}
              monogram={p.monogram}
              urlLabel={p.cover.urlLabel}
            />
            {p.kind === 'research' && (
              <div class="absolute top-2.5 left-2.5 inline-flex items-center gap-1 rounded-full bg-white/95 backdrop-blur px-2 py-0.5 text-[9px] font-mono font-semibold uppercase tracking-widest text-navy shadow-sm">
                <span class="h-1 w-1 rounded-full bg-navy"></span>
                {researchBadge}
              </div>
            )}
            <div class="absolute top-2.5 right-2.5 rounded-full bg-black/20 backdrop-blur px-2 py-0.5 text-[9px] font-medium text-white tracking-wide">
              {p.year}
            </div>
            {p.url && (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="absolute inset-0 flex items-end justify-end p-2.5 opacity-0 group-hover:opacity-100 transition duration-300"
                aria-label={`${openLabel} ${p.title}`}
              >
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-[10px] font-semibold text-navy shadow">
                  {openLabel}
                  <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 13L13 7M7 7h6v6" />
                  </svg>
                </span>
              </a>
            )}
          </div>

          <div class="p-4 sm:p-5 flex-1 flex flex-col">
            <p class="text-[10px] uppercase tracking-[0.18em] text-slate-400">{p.subtitle}</p>
            <h4 class="mt-1 font-display text-lg text-navy leading-tight">{p.title}</h4>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3">{p.description}</p>

            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.slice(0, 4).map((tag) => (
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] text-slate-600">{tag}</span>
              ))}
            </div>

            <div class="mt-auto pt-4 flex items-center justify-between gap-2 border-t border-slate-100 mt-4">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-navy hover:gap-2 transition-all"
                >
                  {visitLabel}
                  <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 13L13 7M7 7h6v6" />
                  </svg>
                </a>
              ) : (
                <span class="text-xs text-slate-400">{p.cover.urlLabel || noUrlLabel}</span>
              )}
              <span class="text-[10px] font-mono text-slate-300">{String(i + 1).padStart(2, '0')}</span>
            </div>
          </div>
        </article>
      ))}

      <div class="flex-none w-2" aria-hidden="true"></div>
    </div>
  </div>

  <div class="mt-5 flex items-center gap-4" aria-hidden="true">
    <div class="flex-1 h-[2px] bg-slate-200 rounded-full overflow-hidden relative">
      <span
        data-progress={cid}
        class="absolute inset-y-0 left-0 bg-navy rounded-full transition-[width] duration-200 ease-out"
        style="width: 20%"
      ></span>
    </div>
    <span
      data-counter={cid}
      class="font-mono text-xs text-slate-500 tabular-nums tracking-wider whitespace-nowrap"
    >
      01 <span class="text-slate-300 mx-0.5">/</span> {String(items.length).padStart(2, '0')}
    </span>
  </div>
</div>

<style is:global>
  .proj-card {
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }
  .proj-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle 240px at var(--mx, 50%) var(--my, 50%),
      rgba(15, 42, 74, 0.10),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.4s ease-out;
    pointer-events: none;
    border-radius: inherit;
    z-index: 2;
  }
  .proj-card:hover {
    box-shadow: 0 25px 50px -12px rgba(15, 42, 74, 0.22);
    border-color: rgb(15 42 74 / 0.3);
  }
  .proj-card[data-kind="research"] {
    border-color: rgb(93 78 55 / 0.35);
    background:
      linear-gradient(180deg, rgba(93, 78, 55, 0.03) 0%, transparent 100%),
      #ffffff;
  }
  .proj-card[data-kind="research"]:hover {
    border-color: rgb(93 78 55 / 0.55);
    box-shadow: 0 25px 50px -12px rgba(93, 78, 55, 0.22);
  }
  .proj-card:hover::before {
    opacity: 1;
  }
  .proj-card.is-tilted {
    transform: perspective(1200px) rotateX(var(--rx, 0)) rotateY(var(--ry, 0)) translateZ(0) scale(1.02);
    transition: transform 0.15s ease-out, box-shadow 0.4s, border-color 0.4s;
  }
  @media (prefers-reduced-motion: reduce) {
    .proj-card,
    .proj-card.is-tilted { transform: none; transition: none; }
    .proj-card::before { display: none; }
  }
</style>

<script is:inline data-cid={cid}>
  (function () {
    const cid = document.currentScript.getAttribute('data-cid');
    const el = document.getElementById(cid);
    if (!el) return;
    const progress = document.querySelector(`[data-progress="${cid}"]`);
    const counter = document.querySelector(`[data-counter="${cid}"]`);
    const fadeLeft = document.querySelector(`[data-fade-left="${cid}"]`);
    const fadeRight = document.querySelector(`[data-fade-right="${cid}"]`);
    const total = el.querySelectorAll('article').length;

    document.querySelectorAll(`[data-scroll="${cid}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        const card = el.querySelector('article');
        const step = card ? card.getBoundingClientRect().width + 20 : 380;
        el.scrollBy({ left: step * dir, behavior: 'smooth' });
      });
    });

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    el.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });
    el.addEventListener('mouseleave', () => (isDown = false));
    el.addEventListener('mouseup', () => (isDown = false));
    el.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      el.scrollLeft = scrollLeft - (x - startX);
    });

    const updateProgress = () => {
      const max = el.scrollWidth - el.clientWidth;
      const ratio = max > 0 ? el.scrollLeft / max : 0;
      if (progress) {
        progress.style.width = `${Math.max(6, Math.min(100, ratio * 100))}%`;
      }
      if (counter) {
        const card = el.querySelector('article');
        if (card) {
          const cardWidth = card.getBoundingClientRect().width + 20;
          const active = Math.min(total, Math.round(el.scrollLeft / cardWidth) + 1);
          const padded = String(active).padStart(2, '0');
          const totalPadded = String(total).padStart(2, '0');
          counter.innerHTML = `${padded} <span class="text-slate-300 mx-0.5">/</span> ${totalPadded}`;
        }
      }
      // Fades solo cuando hay contenido oculto — se atenúan cerca del borde.
      const threshold = 8;
      if (fadeLeft) {
        const opacity = Math.min(1, Math.max(0, (el.scrollLeft - threshold) / 60));
        fadeLeft.style.opacity = String(opacity);
      }
      if (fadeRight) {
        const remaining = max - el.scrollLeft;
        const opacity = max <= 0 ? 0 : Math.min(1, Math.max(0, (remaining - threshold) / 60));
        fadeRight.style.opacity = String(opacity);
      }
    };

    el.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) {
      el.querySelectorAll('[data-tilt]').forEach((card) => {
        let raf = 0;
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const px = x / rect.width;
          const py = y / rect.height;
          const rx = (py - 0.5) * -6;
          const ry = (px - 0.5) * 6;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            card.style.setProperty('--rx', rx + 'deg');
            card.style.setProperty('--ry', ry + 'deg');
            card.style.setProperty('--mx', x + 'px');
            card.style.setProperty('--my', y + 'px');
            card.classList.add('is-tilted');
          });
        });
        card.addEventListener('mouseleave', () => {
          cancelAnimationFrame(raf);
          card.classList.remove('is-tilted');
          card.style.removeProperty('--rx');
          card.style.removeProperty('--ry');
        });
      });
    }
  })();
</script>

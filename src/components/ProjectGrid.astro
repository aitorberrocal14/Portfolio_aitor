---
import BrowserMock from '~/components/BrowserMock.astro';

export interface ProjectItem {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: readonly string[] | string[];
  highlights: readonly string[] | string[];
  cover: { tagline: string; urlLabel: string };
  url?: string;
  year: string;
  bg: string;
  fg: string;
  monogram: string;
}

export interface Props {
  title: string;
  kicker: string;
  items: ProjectItem[];
  countLabel: string;
  openLabel: string;
  visitLabel: string;
  noUrlLabel: string;
}

const { title, kicker, items, countLabel, openLabel, visitLabel, noUrlLabel }: Props = Astro.props;

const cid = `pc-${kicker.replace(/[^\w]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="mt-14" data-reveal>
  <div class="flex items-end justify-between gap-4 mb-7">
    <div>
      <p class="section-number">{kicker}</p>
      <h3 class="font-display text-2xl sm:text-3xl text-navy tracking-tight mt-2">{title}</h3>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <span class="hidden sm:inline-flex items-center gap-2 text-xs text-slate-500 mr-1 font-mono uppercase tracking-wider">
        {countLabel}
      </span>
      <button
        type="button"
        data-scroll={cid}
        data-dir="-1"
        class="grid h-11 w-11 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-30 disabled:pointer-events-none"
        aria-label="Anterior"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 4L7 10l6 6" />
        </svg>
      </button>
      <button
        type="button"
        data-scroll={cid}
        data-dir="1"
        class="grid h-11 w-11 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-30 disabled:pointer-events-none"
        aria-label="Siguiente"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4l6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>

  <div class="relative">
    <div
      class="pointer-events-none absolute left-0 top-0 bottom-4 w-12 z-10 bg-gradient-to-r from-paper to-transparent"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute right-0 top-0 bottom-4 w-12 z-10 bg-gradient-to-l from-paper to-transparent"
      aria-hidden="true"
    ></div>

    <div
      id={cid}
      class="h-scroll overflow-x-auto flex gap-5 sm:gap-6 scroll-smooth pb-4 -mx-[max(1rem,calc((100vw-1120px)/2+1rem))] px-[max(1rem,calc((100vw-1120px)/2+1rem))] cursor-grab active:cursor-grabbing"
    >
      {items.map((p, i) => (
        <article
          class="snap-start group relative flex-none w-[88%] sm:w-[440px] lg:w-[500px] flex flex-col rounded-3xl overflow-hidden border border-slate-200 bg-white transition duration-500 hover:shadow-2xl hover:shadow-navy/15 hover:-translate-y-1 hover:border-navy/30"
        >
          <div class="relative h-44 sm:h-52 overflow-hidden">
            <BrowserMock
              bg={p.bg}
              fg={p.fg}
              tagline={p.cover.tagline}
              monogram={p.monogram}
              urlLabel={p.cover.urlLabel}
            />
            <div class="absolute top-3 right-3 rounded-full bg-black/25 backdrop-blur px-2.5 py-1 text-[10px] font-mono font-medium text-white tracking-wider">
              {p.year}
            </div>
            {p.url && (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="absolute inset-0 flex items-end justify-end p-3 opacity-0 group-hover:opacity-100 transition duration-300"
                aria-label={`${openLabel} ${p.title}`}
              >
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-navy shadow-lg">
                  {openLabel}
                  <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 13L13 7M7 7h6v6" />
                  </svg>
                </span>
              </a>
            )}
          </div>

          <div class="p-5 sm:p-6 flex-1 flex flex-col">
            <p class="text-[10px] uppercase tracking-[0.22em] text-slate-400 font-medium">{p.subtitle}</p>
            <h4 class="mt-1.5 font-display text-xl sm:text-2xl text-navy leading-tight">{p.title}</h4>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-3">{p.description}</p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.slice(0, 4).map((tag) => (
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] text-slate-600">{tag}</span>
              ))}
            </div>

            <div class="mt-auto pt-5 flex items-center justify-between gap-2 border-t border-slate-100 mt-5">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy hover:gap-2.5 transition-all"
                >
                  {visitLabel}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 13L13 7M7 7h6v6" />
                  </svg>
                </a>
              ) : (
                <span class="text-xs text-slate-400 font-mono">{p.cover.urlLabel || noUrlLabel}</span>
              )}
              <span class="text-[10px] font-mono text-slate-300 tracking-wider">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</span>
            </div>
          </div>
        </article>
      ))}

      <div class="flex-none w-2" aria-hidden="true"></div>
    </div>
  </div>

  <div class="mt-5 flex items-center gap-1.5" aria-hidden="true">
    {items.map((_, i) => (
      <span data-dot={cid} data-index={i} class={`h-1 rounded-full transition-all duration-300 ${i === 0 ? 'w-8 bg-navy' : 'w-3 bg-slate-300'}`}></span>
    ))}
  </div>
</div>

<script is:inline data-cid={cid}>
  (function () {
    const cid = document.currentScript.getAttribute('data-cid');
    const el = document.getElementById(cid);
    if (!el) return;
    const dots = document.querySelectorAll(`[data-dot="${cid}"]`);
    const arrows = document.querySelectorAll(`[data-scroll="${cid}"]`);

    const updateState = () => {
      const card = el.querySelector('article');
      if (!card) return;
      const cardWidth = card.getBoundingClientRect().width + 24;
      const active = Math.round(el.scrollLeft / cardWidth);
      dots.forEach((d, i) => {
        const isActive = i === active;
        d.className = `h-1 rounded-full transition-all duration-300 ${isActive ? 'w-8 bg-navy' : 'w-3 bg-slate-300'}`;
      });
      const atStart = el.scrollLeft <= 4;
      const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 4;
      arrows.forEach((btn) => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        if (dir < 0) btn.toggleAttribute('disabled', atStart);
        if (dir > 0) btn.toggleAttribute('disabled', atEnd);
      });
    };

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        const card = el.querySelector('article');
        const step = card ? card.getBoundingClientRect().width + 24 : 480;
        el.scrollBy({ left: step * dir, behavior: 'smooth' });
      });
    });

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    el.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });
    el.addEventListener('mouseleave', () => (isDown = false));
    el.addEventListener('mouseup', () => (isDown = false));
    el.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      el.scrollLeft = scrollLeft - (x - startX);
    });

    el.addEventListener('scroll', updateState, { passive: true });
    window.addEventListener('resize', updateState);
    updateState();
  })();
</script>

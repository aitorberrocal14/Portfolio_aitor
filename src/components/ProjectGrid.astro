---
import BrowserMock from '~/components/BrowserMock.astro';

export interface ProjectItem {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: readonly string[] | string[];
  highlights: readonly string[] | string[];
  cover: { tagline: string; urlLabel: string };
  url?: string;
  year: string;
  bg: string;
  fg: string;
  monogram: string;
}

export interface Props {
  title: string;
  kicker: string;
  items: ProjectItem[];
  countLabel: string;
  openLabel: string;
  visitLabel: string;
  noUrlLabel: string;
}

const { title, kicker, items, countLabel, openLabel, visitLabel, noUrlLabel }: Props = Astro.props;

// Unique id per carousel for scroll/dot wiring.
const cid = `pc-${kicker.replace(/[^\w]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="mt-12" data-reveal>
  <div class="flex items-end justify-between gap-4 mb-6">
    <div>
      <p class="section-number">{kicker}</p>
      <h3 class="font-display text-xl sm:text-2xl text-navy tracking-tight mt-1.5">{title}</h3>
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden sm:inline-flex items-center gap-2 text-xs text-slate-500 mr-1">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 12h10M11 6l-5 6 5 6M13 6l5 6-5 6" />
        </svg>
        {countLabel}
      </span>
      <button
        type="button"
        data-scroll={cid}
        data-dir="-1"
        class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-25 disabled:pointer-events-none"
        aria-label="Anterior"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 4L7 10l6 6" />
        </svg>
      </button>
      <button
        type="button"
        data-scroll={cid}
        data-dir="1"
        class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-25 disabled:pointer-events-none"
        aria-label="Siguiente"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4l6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id={cid}
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={title}
    class="proj-track h-scroll overflow-x-auto flex gap-4 sm:gap-5 scroll-smooth pb-4 -mx-4 px-4 cursor-grab active:cursor-grabbing focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 focus-visible:ring-offset-paper rounded-xl"
  >
    {items.map((p, i) => (
      <article
        class="proj-card snap-start group relative flex-none w-[85%] sm:w-[360px] lg:w-[400px] flex flex-col rounded-2xl overflow-hidden border border-slate-200 bg-white hover:shadow-xl hover:shadow-navy/10 hover:-translate-y-0.5"
      >
        <div class="relative h-36 overflow-hidden">
          <BrowserMock
            bg={p.bg}
            fg={p.fg}
            tagline={p.cover.tagline}
            monogram={p.monogram}
            urlLabel={p.cover.urlLabel}
          />
          <div class="absolute top-2.5 right-2.5 rounded-full bg-black/20 backdrop-blur px-2 py-0.5 text-[9px] font-medium text-white tracking-wide">
            {p.year}
          </div>
          {p.url && (
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class="absolute inset-0 flex items-end justify-end p-2.5 opacity-0 group-hover:opacity-100 transition duration-300"
              aria-label={`${openLabel} ${p.title}`}
            >
              <span class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-[10px] font-semibold text-navy shadow">
                {openLabel}
                <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 13L13 7M7 7h6v6" />
                </svg>
              </span>
            </a>
          )}
        </div>

        <div class="p-4 sm:p-5 flex-1 flex flex-col">
          <p class="text-[10px] uppercase tracking-[0.18em] text-slate-400">{p.subtitle}</p>
          <h4 class="mt-1 font-display text-lg text-navy leading-tight">{p.title}</h4>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3">{p.description}</p>

          <div class="mt-3 flex flex-wrap gap-1.5">
            {p.tags.slice(0, 4).map((tag) => (
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] text-slate-600">{tag}</span>
            ))}
          </div>

          <div class="mt-auto pt-4 flex items-center justify-between gap-2 border-t border-slate-100 mt-4">
            {p.url ? (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-navy hover:gap-2 transition-all"
              >
                {visitLabel}
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 13L13 7M7 7h6v6" />
                </svg>
              </a>
            ) : (
              <span class="text-xs text-slate-400">{p.cover.urlLabel || noUrlLabel}</span>
            )}
            <span class="text-[10px] font-mono text-slate-300">{String(i + 1).padStart(2, '0')}</span>
          </div>
        </div>
      </article>
    ))}

    <div class="flex-none w-2" aria-hidden="true"></div>
  </div>

  <div class="mt-3 flex items-center gap-1.5" aria-hidden="true">
    {items.map((_, i) => (
      <span data-dot={cid} data-index={i} class={`h-1 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-navy' : 'w-3 bg-slate-300'}`}></span>
    ))}
  </div>
</div>

<style is:global>
  .proj-card {
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .proj-card.is-active {
    transform: scale(1.015);
    box-shadow: 0 18px 36px -14px rgba(15, 42, 74, 0.18);
    border-color: rgb(15 42 74 / 0.25);
  }
  .proj-card.is-active:hover {
    transform: scale(1.02) translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .proj-card { transition: none; }
    .proj-card.is-active { transform: none; }
  }
</style>

<script is:inline data-cid={cid}>
  (function () {
    const cid = document.currentScript.getAttribute('data-cid');
    const el = document.getElementById(cid);
    if (!el) return;

    const cards = Array.from(el.querySelectorAll('article'));
    const dots = document.querySelectorAll(`[data-dot="${cid}"]`);
    const arrows = document.querySelectorAll(`[data-scroll="${cid}"]`);

    const stepWidth = () => {
      const card = el.querySelector('article');
      return card ? card.getBoundingClientRect().width + 20 : 380;
    };

    // (C) Disabled state on arrows when at boundaries
    const updateArrows = () => {
      const atStart = el.scrollLeft <= 4;
      const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 4;
      arrows.forEach((btn) => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        if (dir < 0) btn.toggleAttribute('disabled', atStart);
        if (dir > 0) btn.toggleAttribute('disabled', atEnd);
      });
    };

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        el.scrollBy({ left: stepWidth() * dir, behavior: 'smooth' });
      });
    });

    // (A) Keyboard navigation when carousel is focused
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        el.scrollBy({ left: stepWidth(), behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        el.scrollBy({ left: -stepWidth(), behavior: 'smooth' });
      } else if (e.key === 'Home') {
        e.preventDefault();
        el.scrollTo({ left: 0, behavior: 'smooth' });
      } else if (e.key === 'End') {
        e.preventDefault();
        el.scrollTo({ left: el.scrollWidth, behavior: 'smooth' });
      }
    });

    // (B) Active card emphasis based on visibility within carousel
    const vis = new Map();
    const visObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => vis.set(e.target, e.intersectionRatio));
        let best = null;
        let max = 0;
        cards.forEach((c) => {
          const v = vis.get(c) || 0;
          if (v > max) { max = v; best = c; }
        });
        cards.forEach((c) => c.classList.toggle('is-active', c === best && max > 0.5));
      },
      { root: el, threshold: [0, 0.25, 0.5, 0.75, 0.9, 1] }
    );
    cards.forEach((c) => visObserver.observe(c));

    // Drag-to-scroll
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    el.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });
    el.addEventListener('mouseleave', () => (isDown = false));
    el.addEventListener('mouseup', () => (isDown = false));
    el.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      el.scrollLeft = scrollLeft - (x - startX);
    });

    // Dot sync
    const updateDots = () => {
      if (!dots.length) return;
      const active = Math.round(el.scrollLeft / stepWidth());
      dots.forEach((d, i) => {
        const isActive = i === active;
        d.className = `h-1 rounded-full transition-all duration-300 ${isActive ? 'w-6 bg-navy' : 'w-3 bg-slate-300'}`;
      });
    };

    el.addEventListener('scroll', () => { updateDots(); updateArrows(); }, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
    updateDots();
  })();
</script>

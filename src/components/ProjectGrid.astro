---
import BrowserMock from '~/components/BrowserMock.astro';

export interface ProjectItem {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: readonly string[] | string[];
  highlights: readonly string[] | string[];
  cover: { tagline: string; urlLabel: string };
  url?: string;
  year: string;
  bg: string;
  fg: string;
  monogram: string;
}

export interface Props {
  title: string;
  kicker: string;
  items: ProjectItem[];
  countLabel: string;
  openLabel: string;
  visitLabel: string;
  noUrlLabel: string;
}

const { title, kicker, items, countLabel, openLabel, visitLabel, noUrlLabel }: Props = Astro.props;

const cid = `pc-${kicker.replace(/[^\w]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="mt-14 proj-carousel" data-reveal>
  <div class="flex items-end justify-between gap-4 mb-7">
    <div>
      <p class="section-number">{kicker}</p>
      <h3 class="font-display text-2xl sm:text-3xl text-navy tracking-tight mt-2">{title}</h3>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <span class="hidden sm:inline-flex items-center gap-2 text-xs text-slate-500 mr-1 font-mono uppercase tracking-wider">
        {countLabel}
      </span>
      <button
        type="button"
        data-scroll={cid}
        data-dir="-1"
        class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-25 disabled:pointer-events-none"
        aria-label="Anterior"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 4L7 10l6 6" />
        </svg>
      </button>
      <button
        type="button"
        data-scroll={cid}
        data-dir="1"
        class="grid h-10 w-10 place-items-center rounded-full border border-slate-300 text-navy transition hover:border-navy hover:bg-navy hover:text-white disabled:opacity-25 disabled:pointer-events-none"
        aria-label="Siguiente"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4l6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id={cid}
    class="proj-track h-scroll overflow-x-auto flex gap-3 sm:gap-4 scroll-smooth py-2 -mx-[max(1rem,calc((100vw-1120px)/2+1rem))] px-[max(1rem,calc((100vw-1120px)/2+1rem))] cursor-grab active:cursor-grabbing"
  >
    {items.map((p, i) => (
      <article
        class="proj-card snap-start group relative flex-none w-[78%] sm:w-[260px] lg:w-[280px] flex flex-col rounded-2xl overflow-hidden border border-slate-200 bg-white"
      >
        <div class="relative h-32 overflow-hidden">
          <BrowserMock
            bg={p.bg}
            fg={p.fg}
            tagline={p.cover.tagline}
            monogram={p.monogram}
            urlLabel={p.cover.urlLabel}
          />
          <div class="absolute top-2 right-2 rounded-full bg-black/30 backdrop-blur px-2 py-0.5 text-[9px] font-mono font-medium text-white tracking-wider">
            {p.year}
          </div>
          {p.url && (
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class="absolute inset-0 flex items-end justify-end p-2 opacity-0 group-hover:opacity-100 transition duration-300"
              aria-label={`${openLabel} ${p.title}`}
            >
              <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-[10px] font-semibold text-navy shadow">
                {openLabel}
                <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 13L13 7M7 7h6v6" />
                </svg>
              </span>
            </a>
          )}
        </div>

        <div class="p-3.5 sm:p-4 flex-1 flex flex-col">
          <p class="text-[9px] uppercase tracking-[0.2em] text-slate-400 font-medium line-clamp-1">{p.subtitle}</p>
          <h4 class="mt-1 font-display text-base sm:text-[17px] text-navy leading-tight">{p.title}</h4>
          <p class="mt-2 text-[12px] text-slate-600 leading-snug line-clamp-2">{p.description}</p>

          <div class="mt-2.5 flex flex-wrap gap-1">
            {p.tags.slice(0, 3).map((tag) => (
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[9px] text-slate-600">{tag}</span>
            ))}
          </div>

          <div class="mt-auto pt-3 flex items-center justify-between gap-2 border-t border-slate-100 mt-3">
            {p.url ? (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 text-[11px] font-semibold text-navy hover:gap-2 transition-all"
              >
                {visitLabel}
                <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 13L13 7M7 7h6v6" />
                </svg>
              </a>
            ) : (
              <span class="text-[10px] text-slate-400 font-mono">{p.cover.urlLabel || noUrlLabel}</span>
            )}
            <span class="text-[9px] font-mono text-slate-300 tracking-wider">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</span>
          </div>
        </div>
      </article>
    ))}

    <div class="flex-none w-2" aria-hidden="true"></div>
  </div>

  <div class="mt-5 flex items-center gap-4">
    <div class="flex-1 h-[2px] rounded-full bg-slate-200 overflow-hidden">
      <div
        data-progress={cid}
        class="h-full bg-navy rounded-full origin-left transition-[width] duration-200 ease-out"
        style="width: 20%"
      ></div>
    </div>
    <span data-counter={cid} class="text-[10px] font-mono text-slate-400 tracking-wider whitespace-nowrap">01 / {String(items.length).padStart(2, '0')}</span>
  </div>
</div>

<style is:global>
  .proj-card {
    transition: box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .proj-card:hover {
    box-shadow: 0 20px 40px -12px rgba(15, 42, 74, 0.18);
    border-color: rgb(15 42 74 / 0.3);
    transform: translateY(-2px);
  }
</style>

<script is:inline data-cid={cid}>
  (function () {
    const cid = document.currentScript.getAttribute('data-cid');
    const el = document.getElementById(cid);
    if (!el) return;

    const cards = el.querySelectorAll('article');
    const progress = document.querySelector(`[data-progress="${cid}"]`);
    const counter = document.querySelector(`[data-counter="${cid}"]`);
    const arrows = document.querySelectorAll(`[data-scroll="${cid}"]`);

    const gap = 16;
    const cardStep = () => {
      const card = el.querySelector('article');
      return card ? card.getBoundingClientRect().width + gap : 280;
    };

    const updateState = () => {
      const max = el.scrollWidth - el.clientWidth;
      const ratio = max > 0 ? el.scrollLeft / max : 0;
      if (progress) {
        progress.style.width = `${Math.max(8, ratio * 100)}%`;
      }
      const active = Math.min(cards.length, Math.round(el.scrollLeft / cardStep()) + 1);
      if (counter) {
        counter.textContent = `${String(active).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      }
      const atStart = el.scrollLeft <= 4;
      const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 4;
      arrows.forEach((btn) => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        if (dir < 0) btn.toggleAttribute('disabled', atStart);
        if (dir > 0) btn.toggleAttribute('disabled', atEnd);
      });
    };

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir') || '1');
        el.scrollBy({ left: cardStep() * dir, behavior: 'smooth' });
      });
    });

    // Drag-to-scroll with momentum + snap on release
    let isDown = false;
    let dragged = false;
    let startX = 0;
    let startScroll = 0;
    let velocity = 0;
    let lastX = 0;
    let lastT = 0;
    let raf = 0;

    el.addEventListener('mousedown', (e) => {
      isDown = true;
      dragged = false;
      startX = e.pageX;
      startScroll = el.scrollLeft;
      lastX = e.pageX;
      lastT = performance.now();
      velocity = 0;
      cancelAnimationFrame(raf);
    });

    const snapToNearest = () => {
      const step = cardStep();
      const target = Math.round(el.scrollLeft / step) * step;
      el.scrollTo({ left: target, behavior: 'smooth' });
    };

    const release = () => {
      if (!isDown) return;
      isDown = false;
      const decel = 0.93;
      let v = velocity;
      const animate = () => {
        v *= decel;
        if (Math.abs(v) < 0.5) {
          snapToNearest();
          return;
        }
        el.scrollLeft -= v;
        raf = requestAnimationFrame(animate);
      };
      if (Math.abs(v) > 1) {
        raf = requestAnimationFrame(animate);
      } else {
        snapToNearest();
      }
    };

    el.addEventListener('mouseleave', release);
    el.addEventListener('mouseup', release);
    el.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const dx = e.pageX - startX;
      if (Math.abs(dx) > 3) dragged = true;
      el.scrollLeft = startScroll - dx;
      const now = performance.now();
      const dt = now - lastT;
      if (dt > 0) velocity = ((e.pageX - lastX) / dt) * 16;
      lastX = e.pageX;
      lastT = now;
    });

    // Prevent clicks while dragging
    el.addEventListener('click', (e) => {
      if (dragged) {
        e.preventDefault();
        e.stopPropagation();
        dragged = false;
      }
    }, true);

    // Vertical wheel → horizontal scroll
    el.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          el.scrollLeft += e.deltaY;
        }
      },
      { passive: false }
    );

    el.addEventListener('scroll', updateState, { passive: true });
    window.addEventListener('resize', updateState);
    updateState();
  })();
</script>

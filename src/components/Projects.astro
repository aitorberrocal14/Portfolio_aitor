---
import SectionHeader from '~/components/SectionHeader.astro';
import ProjectGrid from '~/components/ProjectGrid.astro';
import { getDict } from '~/i18n';
import { projectMeta } from '~/data/site';

const t = getDict(Astro.url).projects;
const merge = (item: typeof t.items[number]) => ({ ...item, ...projectMeta[item.id] });

// Escaparate unificado: Match Bilbao primero (recién publicado),
// después productos propios en producción, marca paraguas, y por
// último las investigaciones (aún sin página de detalle propia).
const projects = (
  ['match-bilbao', 'toca', 'mozkor', 'porra-mundial', 'bercay', 'tfm', 'turismo-bilbao'] as const
)
  .map((id) => t.items.find((i) => i.id === id)!)
  .map(merge);
---

<section id="proyectos" class="section section-divide">
  <div class="container">
    <SectionHeader
      number={t.number}
      label={t.kicker}
      title={t.title}
      description={t.description}
    />

    <div class="mt-14">
      <ProjectGrid
        items={projects}
        countLabel={t.countLabel(projects.length)}
        openLabel={t.openLabel}
        visitLabel={t.visitLabel}
        noUrlLabel={t.noUrlLabel}
        researchBadge={t.researchBadge}
      />
    </div>
  </div>
</section>

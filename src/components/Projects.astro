---
import SectionHeader from '~/components/SectionHeader.astro';
import BranchHeader from '~/components/BranchHeader.astro';
import ProjectGrid from '~/components/ProjectGrid.astro';
import { getDict } from '~/i18n';
import { projectMeta } from '~/data/site';

const t = getDict(Astro.url).projects;
const merge = (item: typeof t.items[number]) => ({ ...item, ...projectMeta[item.id] });

// Rama 01 — Software & IA: Match Bilbao primero (recién publicado).
const software = (
  ['match-bilbao', 'toca', 'mozkor', 'porra-mundial', 'bercay'] as const
)
  .map((id) => t.items.find((i) => i.id === id)!)
  .map(merge);

// Rama 02 — Investigación social.
const research = (['tfm', 'turismo-bilbao'] as const)
  .map((id) => t.items.find((i) => i.id === id)!)
  .map(merge);

// Etiqueta plural del contador según idioma (extraída de countLabel(2)).
const countNoun = t.countLabel(2).replace(/^\d+\s*/, '');
---

<section id="proyectos" class="section-tight section-divide">
  <div class="container">
    <div class="flex flex-col gap-3" data-reveal>
      <div class="flex items-center gap-4">
        <span class="section-number">{t.number}</span>
        <span class="h-px w-10 bg-slate-300"></span>
        <span class="eyebrow">{t.kicker}</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-navy tracking-[-0.015em] leading-[1.05] max-w-3xl">
        {t.title}
      </h2>
      <p class="max-w-2xl text-sm sm:text-base text-slate-600 leading-relaxed">
        {t.description}
      </p>
    </div>

    <div class="mt-10 sm:mt-12">
      <BranchHeader
        index="01"
        title={t.softwareTitle}
        count={software.length}
        countLabel={countNoun}
        context={t.softwareContext}
      />
      <ProjectGrid
        items={software}
        countLabel={t.countLabel(software.length)}
        openLabel={t.openLabel}
        visitLabel={t.visitLabel}
        noUrlLabel={t.noUrlLabel}
        researchBadge={t.researchBadge}
      />
    </div>

    <div class="my-14 sm:my-20 grid grid-cols-[1fr_auto_1fr] items-center gap-5 sm:gap-8" aria-hidden="true" data-reveal>
      <div class="h-px w-full bg-gradient-to-r from-transparent via-navy/25 to-navy/25"></div>
      <div class="flex flex-col items-center gap-1.5">
        <span class="font-mono text-[9px] uppercase tracking-[0.4em] text-slate-400 whitespace-nowrap">
          {t.branchSwitchLabel}
        </span>
        <span class="font-display italic text-xl text-navy/60 leading-none">⁂</span>
      </div>
      <div class="h-px w-full bg-gradient-to-l from-transparent via-navy/25 to-navy/25"></div>
    </div>

    <div>
      <BranchHeader
        index="02"
        title={t.researchTitle}
        count={research.length}
        countLabel={countNoun}
        context={t.researchContext}
      />
      <ProjectGrid
        items={research}
        countLabel={t.countLabel(research.length)}
        openLabel={t.openLabel}
        visitLabel={t.visitLabel}
        noUrlLabel={t.noUrlLabel}
        researchBadge={t.researchBadge}
      />
    </div>
  </div>
</section>

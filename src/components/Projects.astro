---
import SectionHeader from '~/components/SectionHeader.astro';
import BranchHeader from '~/components/BranchHeader.astro';
import ProjectGrid from '~/components/ProjectGrid.astro';
import { getDict } from '~/i18n';
import { projectMeta } from '~/data/site';

const t = getDict(Astro.url).projects;
const merge = (item: typeof t.items[number]) => ({ ...item, ...projectMeta[item.id] });

// Rama 01 — Software & IA: Match Bilbao primero (recién publicado).
const software = (
  ['match-bilbao', 'toca', 'mozkor', 'porra-mundial', 'bercay'] as const
)
  .map((id) => t.items.find((i) => i.id === id)!)
  .map(merge);

// Rama 02 — Investigación social.
const research = (['tfm', 'turismo-bilbao'] as const)
  .map((id) => t.items.find((i) => i.id === id)!)
  .map(merge);

// Etiqueta plural del contador según idioma (extraída de countLabel(2)).
const countNoun = t.countLabel(2).replace(/^\d+\s*/, '');
---

<section id="proyectos" class="section section-divide">
  <div class="container">
    <SectionHeader
      number={t.number}
      label={t.kicker}
      title={t.title}
      description={t.description}
    />

    <div class="mt-16 sm:mt-20">
      <BranchHeader index="01" title={t.softwareTitle} count={software.length} countLabel={countNoun} />
      <ProjectGrid
        items={software}
        countLabel={t.countLabel(software.length)}
        openLabel={t.openLabel}
        visitLabel={t.visitLabel}
        noUrlLabel={t.noUrlLabel}
        researchBadge={t.researchBadge}
      />
    </div>

    <div class="my-20 sm:my-28 flex items-center gap-5" aria-hidden="true">
      <div class="h-px flex-1 bg-navy/15"></div>
      <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-slate-400 whitespace-nowrap">
        ⁂
      </span>
      <div class="h-px flex-1 bg-navy/15"></div>
    </div>

    <div>
      <BranchHeader index="02" title={t.researchTitle} count={research.length} countLabel={countNoun} />
      <ProjectGrid
        items={research}
        countLabel={t.countLabel(research.length)}
        openLabel={t.openLabel}
        visitLabel={t.visitLabel}
        noUrlLabel={t.noUrlLabel}
        researchBadge={t.researchBadge}
      />
    </div>
  </div>
</section>

---
export interface Props {
  index: string;
  title: string;
  countLabel?: string;
}

const { index, title, countLabel }: Props = Astro.props;
---

<div class="flex items-end justify-between gap-4 mb-10 border-b border-slate-200/80 pb-5" data-reveal>
  <div>
    <p class="font-mono text-[11px] text-slate-500 tracking-[0.25em] uppercase">{index} —</p>
    <h3 class="mt-2 font-display text-3xl sm:text-4xl lg:text-5xl text-navy tracking-[-0.015em] leading-[1.05]">{title}</h3>
  </div>
  {countLabel && (
    <span class="font-mono text-[10px] text-slate-400 uppercase tracking-widest whitespace-nowrap hidden sm:inline pb-2">
      {countLabel}
    </span>
  )}
</div>

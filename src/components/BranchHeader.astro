---
export interface Props {
  index: string;
  title: string;
  count: number;
  countLabel?: string;
  context?: string;
}

const { index, title, count, countLabel = 'Proyectos', context = '' }: Props = Astro.props;
const cidBH = `bh-${index}-${Math.random().toString(36).slice(2, 7)}`;
const target = String(count).padStart(2, '0');
---

<div
  class="branch-header flex items-end justify-between gap-6 mb-4 pb-4 border-b border-slate-200/80"
  data-reveal
  data-branch={cidBH}
>
  <div class="min-w-0">
    <p class="font-mono text-[11px] tracking-[0.28em] text-slate-500 uppercase flex items-center gap-2">
      <span class="inline-block h-px w-6 bg-slate-400/70"></span>
      Rama {index}
    </p>
    <h3 class="mt-1.5 font-display text-2xl sm:text-3xl lg:text-4xl text-navy tracking-[-0.015em] leading-[1.05] truncate">
      {title}
    </h3>
    {context && (
      <p class="mt-2 font-display italic text-sm sm:text-base text-slate-500 leading-snug max-w-xl">
        {context}
      </p>
    )}
  </div>
  <div class="text-right flex-none pb-0.5">
    <p class="font-mono text-[10px] tracking-[0.28em] text-slate-400 uppercase">{countLabel}</p>
    <p
      class="mt-1 font-display text-3xl sm:text-4xl lg:text-5xl text-navy tabular-nums leading-none tracking-tight"
      data-count-target={target}
    >
      {target}
    </p>
  </div>
</div>

<script is:inline data-bh-cid={cidBH}>
  (function () {
    const cid = document.currentScript.getAttribute('data-bh-cid');
    const wrap = document.querySelector(`[data-branch="${cid}"]`);
    if (!wrap) return;
    const numEl = wrap.querySelector('[data-count-target]');
    if (!numEl) return;
    const target = parseInt(numEl.getAttribute('data-count-target') || '0', 10);
    if (!target || target < 1) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const pad = (n) => String(n).padStart(2, '0');
    let played = false;

    const animate = () => {
      if (played) return;
      played = true;
      const duration = 900;
      const start = performance.now();
      const ease = (t) => 1 - Math.pow(1 - t, 3);
      const step = (now) => {
        const t = Math.min(1, (now - start) / duration);
        const value = Math.round(ease(t) * target);
        numEl.textContent = pad(value);
        if (t < 1) requestAnimationFrame(step);
        else numEl.textContent = pad(target);
      };
      numEl.textContent = pad(0);
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate();
          io.disconnect();
        }
      });
    }, { threshold: 0.35 });
    io.observe(wrap);
  })();
</script>

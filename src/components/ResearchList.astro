---
import type { ProjectItem } from '~/components/ProjectGrid.astro';

export interface Props {
  items: ProjectItem[];
  visitLabel: string;
}

const { items, visitLabel }: Props = Astro.props;
---

<div class="mt-14 space-y-16 sm:space-y-20">
  {items.map((p, i) => (
    <article
      class="research-entry relative pb-14 sm:pb-16 border-b border-slate-200 last:border-b-0 last:pb-0"
      data-reveal
      style={`--reveal-delay: ${i * 80}ms`}
    >
      <div class="flex items-baseline justify-between gap-6 font-mono text-[11px] uppercase tracking-[0.22em] text-slate-500">
        <span>{p.year}</span>
        <span class="text-right text-slate-500 max-w-[70%]">{p.subtitle}</span>
      </div>

      <h4 class="mt-5 font-display text-3xl sm:text-4xl lg:text-[3rem] text-navy tracking-[-0.02em] leading-[1.05] max-w-4xl">
        {p.title}
      </h4>

      <p class="mt-6 text-lg text-slate-700 leading-relaxed max-w-3xl">
        {p.description}
      </p>

      {p.highlights.length > 0 && (
        <ul class="mt-8 space-y-2.5 max-w-2xl">
          {p.highlights.map((h) => (
            <li class="flex gap-3 text-base text-slate-600 leading-relaxed">
              <span class="text-navy flex-none font-mono mt-[0.15em]">—</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] uppercase tracking-[0.22em] text-slate-500 flex-1 min-w-0">
          {p.tags.map((tag, ti) => (
            <>
              {ti > 0 && <span class="text-slate-300" aria-hidden="true">·</span>}
              <span>{tag}</span>
            </>
          ))}
        </div>
        {p.url && (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-navy hover:gap-2.5 transition-all whitespace-nowrap"
          >
            {visitLabel}
            <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 13L13 7M7 7h6v6" />
            </svg>
          </a>
        )}
      </div>
    </article>
  ))}
</div>
